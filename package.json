{
  "name": "micromatch",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "paraglide:compile": "bun run scripts/compile-paraglide.ts",
    "precheck": "bun run paraglide:compile",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --fail-on-warnings --tsconfig ./tsconfig.json --output human",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:audit": "playwright test --config=playwright.audit.config.ts",
    "test:accessibility": "playwright test --config=playwright.accessibility.config.ts",
    "test:responsiveness": "playwright test --config=playwright.responsiveness.config.ts",
    "verify:a11y-matrix": "bun run scripts/verify-a11y-matrix.ts",
    "test:demo": "DEMO=1 playwright test --config=playwright.demo.config.ts",
    "demo:gif": "bun run scripts/demos-to-gif.ts",
    "demo": "bun run seed && bun run test:demo && bun run demo:gif",
    "seed": "bun run scripts/seed.ts",
    "verify:libretranslate": "bun run scripts/verify-libretranslate.ts",
    "render-media": "bun run scripts/render-media.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@iconify/svelte": "^5.2.2",
    "@smui/button": "^9.0.2",
    "@smui/card": "^9.0.2",
    "@smui/chips": "^9.0.3",
    "@smui/dialog": "^9.0.2",
    "@smui/fab": "^9.0.2",
    "@smui/icon-button": "^9.0.2",
    "@smui/linear-progress": "^9.0.2",
    "@smui/list": "^9.0.2",
    "@smui/snackbar": "^9.0.2",
    "@smui/textfield": "^9.0.2",
    "@smui/top-app-bar": "^9.0.2",
    "@sveltejs/kit": "^2.70.3",
    "@vercel/analytics": "^2.0.1",
    "appwrite": "^26.2.0",
    "canvas-confetti": "1.9.4",
    "lottie-web": "5.13.0",
    "mode-watcher": "^1.1.0",
    "node-appwrite": "^28.0.0",
    "svelte": "^5.57.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lottiefiles/lottie-types": "^1.5.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "csstype": "^3.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}