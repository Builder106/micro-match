{
  "name": "micromatch",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "paraglide:compile": "bun run scripts/compile-paraglide.ts",
    "precheck": "bun run paraglide:compile",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --fail-on-warnings --tsconfig ./tsconfig.json --output human",
    "check:tsgo": "bun run paraglide:compile && svelte-check --fail-on-warnings --tsconfig ./tsconfig.json --output human --tsgo",
    "typecheck": "bun run paraglide:compile && svelte-kit sync && tsc6 --noEmit",
    "test": "bun run paraglide:compile && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:functional": "playwright test --project=functional",
    "test:responsiveness": "playwright test --project=responsiveness",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test --project=accessibility",
    "test:vercel": "node scripts/ci/vercel-smoke.mjs",
    "seed": "bun run scripts/seed.ts",
    "verify:libretranslate": "bun run scripts/verify-libretranslate.ts",
    "verify:staging": "bun run scripts/verify-staging.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.2",
    "@sveltejs/kit": "^2.70.3",
    "appwrite": "^29.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "node-appwrite": "^29.0.0",
    "svelte": "^5.57.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "svelte-check": "^4.7.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "5.0.1"
  }
}
