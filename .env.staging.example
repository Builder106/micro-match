# MicroMatch Staging Environment Variables (.env.staging)
# Used for the staging deployment (branch: staging) and local staging QA.
# Scope these variables in Vercel to: Preview Environment -> Git Branch: staging

APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=micromatch-staging

PUBLIC_APPWRITE_PROJECT_ID=micromatch-staging
PUBLIC_APP_URL=https://staging.micromatch.app
PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
PUBLIC_APPWRITE_AVATARS_BUCKET_ID=avatars

# Staging Server API Key (must be generated in Appwrite Cloud Console under micromatch-staging)
APPWRITE_API_KEY=

APPWRITE_DB_ID=micromatch
APPWRITE_TASKS_TABLE_ID=tasks
APPWRITE_CLAIMS_TABLE_ID=claims
APPWRITE_BADGES_TABLE_ID=badges
APPWRITE_AVATARS_BUCKET_ID=avatars
APPWRITE_ADMIN_TEAM_ID=admin
APPWRITE_VERIFICATIONS_TABLE_ID=ngoVerifications
APPWRITE_VERIFICATIONS_BUCKET_ID=verifications
APPWRITE_BADGE_DEFS_TABLE_ID=badgeDefinitions

APPWRITE_NGO_TEAM_ID=ngo
APPWRITE_VOLUNTEER_TEAM_ID=volunteer

# Plunk Transactional Email
PLUNK_SECRET_KEY=
PLUNK_API_URL=https://next-api.useplunk.com
PLUNK_FROM_ADDRESS=
PLUNK_FROM_NAME=MicroMatch

# Azure Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Demo / Seed Fixtures for Staging QA
# Run `bun run seed` with these set to populate staging accounts and tasks
SEED_DEMO_PASSWORD=
SEED_DEMO_EMAIL=demo-staging@micromatch.app
SEED_DEMO_NAME="MicroMatch Staging NGO"
SEED_VOLUNTEER_EMAIL=volunteer-staging@micromatch.app
SEED_VOLUNTEER_NAME="Staging Volunteer"
SEED_BADGE_LABEL="First Mission"

# LibreTranslate (self-hosted on Oracle VM behind named Cloudflare Tunnel)
LIBRETRANSLATE_ENDPOINT=https://translate.micromatch.app
LIBRETRANSLATE_API_KEY=
