{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "checkJs": false,
    "strict": true,
    "types": ["$app/types", "bun", "svelte"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    ".svelte-kit/ambient.d.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "extends": "$app/tsconfig"
}
